import com.jcraft.jsch.*;
import org.springframework.stereotype.Service;

import java.io.File;

@Service
public class SftpPemService {

    public void uploadFileWithPem(String host, int port, String username,
                                  String pemFilePath,
                                  String localFilePath, String remoteFilePath) throws Exception {

        JSch jsch = new JSch();
        jsch.addIdentity(pemFilePath); // path to your private key (.pem)

        Session session = jsch.getSession(username, host, port);
        session.setConfig("StrictHostKeyChecking", "no"); // Only for dev/testing
        session.connect();

        ChannelSftp sftpChannel = (ChannelSftp) session.openChannel("sftp");
        sftpChannel.connect();

        // Upload file
        sftpChannel.put(localFilePath, remoteFilePath);

        // Cleanup
        sftpChannel.disconnect();
        session.disconnect();
    }
}
