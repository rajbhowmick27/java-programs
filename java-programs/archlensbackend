class FileMeta {
    String name;
    long sizeInBytes;

    FileMeta(String name, long sizeInBytes) {
        this.name = name;
        this.sizeInBytes = sizeInBytes;
    }
}

class Bucket implements Comparable<Bucket> {
    int id;
    long remaining;
    List<FileMeta> contents = new ArrayList<>();

    Bucket(int id, long remaining) {
        this.id = id;
        this.remaining = remaining;
    }

    void add(FileMeta file) {
        contents.add(file);
        remaining -= file.sizeInBytes;
    }

    @Override
    public int compareTo(Bucket o) {
        int cmp = Long.compare(this.remaining, o.remaining);
        return cmp == 0 ? Integer.compare(this.id, o.id) : cmp;
    }

    @Override
    public boolean equals(Object obj) {
        return obj instanceof Bucket && this.id == ((Bucket) obj).id;
    }

    @Override
    public int hashCode() {
        return Objects.hash(id);
    }
}





private static int greedyFit(List<FileMeta> files) {
    List<Long> sizes = files.stream()
        .map(f -> f.sizeInBytes)
        .sorted(Comparator.reverseOrder())
        .collect(Collectors.toList());

    List<Long> buckets = new ArrayList<>();

    for (long size : sizes) {
        boolean placed = false;
        for (int i = 0; i < buckets.size(); i++) {
            if (buckets.get(i) + size <= BUCKET_CAPACITY) {
                buckets.set(i, buckets.get(i) + size);
                placed = true;
                break;
            }
        }
        if (!placed) buckets.add(size);
    }

    return buckets.size();
}





public static List<List<FileMeta>> packFilesOptimally(List<FileMeta> files) {
    long totalSize = files.stream().mapToLong(f -> f.sizeInBytes).sum();
    int lo = (int) Math.ceil((double) totalSize / BUCKET_CAPACITY);
    int hi = greedyFit(files);
    List<List<FileMeta>> result = null;

    while (lo <= hi) {
        int mid = (lo + hi) / 2;
        List<List<FileMeta>> candidate = tryFit(files, mid);
        if (candidate != null) {
            result = candidate;
            hi = mid - 1;
        } else {
            lo = mid + 1;
        }
    }

    return result;
}




private static List<List<FileMeta>> tryFit(List<FileMeta> files, int bucketCount) {
    TreeSet<Bucket> buckets = new TreeSet<>();
    for (int i = 0; i < bucketCount; i++) {
        buckets.add(new Bucket(i, BUCKET_CAPACITY));
    }

    for (FileMeta file : files) {
        Bucket target = buckets.ceiling(new Bucket(-1, file.sizeInBytes));
        if (target == null) return null;

        buckets.remove(target);
        target.add(file);
        buckets.add(target);
    }

    List<List<FileMeta>> result = new ArrayList<>();
    for (int i = 0; i < bucketCount; i++) result.add(new ArrayList<>());
    for (Bucket b : buckets) result.set(b.id, b.contents);

    return result;
}





public static void main(String[] args) {
    List<FileMeta> files = new ArrayList<>();
    files.add(new FileMeta("file1.pdf", 100L * 1024 * 1024)); // 100 MB
    files.add(new FileMeta("file2.pdf", 300L * 1024 * 1024)); // 300 MB
    files.add(new FileMeta("file3.pdf", 250L * 1024 * 1024)); // 250 MB
    files.add(new FileMeta("file4.pdf", 150L * 1024 * 1024)); // etc.
    files.add(new FileMeta("file5.pdf", 200L * 1024 * 1024));
    files.add(new FileMeta("file6.pdf", 400L * 1024 * 1024));
    files.add(new FileMeta("file7.pdf", 180L * 1024 * 1024));

    List<List<FileMeta>> result = packFilesOptimally(files);

    for (int i = 0; i < result.size(); i++) {
        System.out.println("Bucket " + (i + 1) + ":");
        for (FileMeta f : result.get(i)) {
            System.out.println("  " + f.name + " (" + f.sizeInBytes / (1024 * 1024) + " MB)");
        }
    }
}
