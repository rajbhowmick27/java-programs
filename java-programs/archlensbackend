import com.jcraft.jsch.*;
import java.io.*;
import java.nio.file.Files;
import java.util.Vector;

public class SFTPWithKeyFromClasspath {

    public static void main(String[] args) throws Exception {
        String host = "your.sftp.server.com";
        int port = 22;
        String username = "your_user";
        String passphrase = "your_key_passphrase"; // or null

        // Load the key from classpath
        InputStream keyStream = SFTPWithKeyFromClasspath.class
            .getClassLoader()
            .getResourceAsStream("private_key.pem");

        if (keyStream == null) {
            throw new FileNotFoundException("private_key.pem not found in resources");
        }

        // Write to a temp file
        File tempKeyFile = File.createTempFile("temp_sftp_key", ".pem");
        tempKeyFile.deleteOnExit();
        Files.copy(keyStream, tempKeyFile.toPath(), java.nio.file.StandardCopyOption.REPLACE_EXISTING);

        JSch jsch = new JSch();
        jsch.addIdentity(tempKeyFile.getAbsolutePath(), passphrase);

        Session session = jsch.getSession(username, host, port);
        session.setConfig("StrictHostKeyChecking", "no");
        session.connect();

        Channel channel = session.openChannel("sftp");
        channel.connect();

        ChannelSftp sftp = (ChannelSftp) channel;

        Vector<ChannelSftp.LsEntry> entries = sftp.ls("/remote/path/");
        for (ChannelSftp.LsEntry entry : entries) {
            System.out.println(entry.getFilename());
        }

        sftp.disconnect();
        session.disconnect();
    }
}
