package com.awsmap.model;

import java.util.Map;

public class GraphNode {
    public String id;
    public String name;
    public String type;
    public Map<String, Object> details;

    public GraphNode(String id, String name, String type, Map<String, Object> details) {
        this.id = id;
        this.name = name;
        this.type = type;
        this.details = details;
    }
}


