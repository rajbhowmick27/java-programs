package com.awsmap.controller;

import com.awsmap.model.GraphNode;
import com.awsmap.service.AwsGraphService;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RestController;

import java.util.Map;

@RestController
@RequestMapping("/api/resources")
public class ResourceGraphController {

    private final AwsGraphService graphService;

    public ResourceGraphController(AwsGraphService graphService) {
        this.graphService = graphService;
    }

    @GetMapping("/graph")
    public Map<String, Object> getGraph() {
        return graphService.buildGraph();
    }
}


// --- src/main/java/com/awsmap/service/AwsGraphService.java ---
package com.awsmap.service;

import com.awsmap.model.GraphNode;
import com.awsmap.scanner.*;
import org.springframework.stereotype.Service;

import java.util.*;

@Service
public class AwsGraphService {

    private final List<ResourceScanner> scanners = List.of(
        new LambdaScanner(),
        new EC2Scanner(),
        new ECSScanner(),
        new ALBScanner(),
        new Route53Scanner(),
        new S3Scanner(),
        new DynamoDBScanner(),
        new IAMScanner(),
        new VPCScanner()
    );

    public Map<String, Object> buildGraph() {
        List<GraphNode> nodes = new ArrayList<>();
        List<Map<String, Object>> edges = new ArrayList<>();

        for (ResourceScanner scanner : scanners) {
            scanner.scan(nodes, edges);
        }

        Map<String, Object> response = new HashMap<>();
        response.put("nodes", nodes);
        response.put("edges", edges);
        return response;
    }
}


