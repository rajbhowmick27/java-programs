package com.awsmap.scanner;

import com.awsmap.model.GraphNode;
import java.util.List;
import java.util.Map;

public interface ResourceScanner {
    void scan(List<GraphNode> nodes, List<Map<String, Object>> edges);
}


// --- src/main/java/com/awsmap/scanner/LambdaScanner.java ---
package com.awsmap.scanner;

import com.awsmap.model.GraphNode;
import software.amazon.awssdk.services.lambda.LambdaClient;
import software.amazon.awssdk.services.lambda.model.ListFunctionsResponse;

import java.util.*;

public class LambdaScanner implements ResourceScanner {
    public void scan(List<GraphNode> nodes, List<Map<String, Object>> edges) {
        try (LambdaClient client = LambdaClient.create()) {
            ListFunctionsResponse response = client.listFunctions();
            response.functions().forEach(fn -> {
                String id = fn.functionArn();
                nodes.add(new GraphNode(
                        id,
                        fn.functionName(),
                        "lambda",
                        Map.of("runtime", fn.runtimeAsString(), "role", fn.role())
                ));
                edges.add(Map.of("from", id, "to", fn.role(), "relationship", "uses-role"));
            });
        }
    }
}


