import React from "react";
import { Handle, Position } from "reactflow";

const GroupNode = ({ id, data, selected }) => {
  return (
    <div
      style={{
        position: "relative",
        width: "100%",
        height: "100%",
        border: selected ? "2px solid #3b82f6" : "2px solid #94a3b8",
        borderRadius: "12px",
        backgroundColor: "#f8fafc",
        boxShadow: "0 4px 10px rgba(0, 0, 0, 0.05)",
        overflow: "visible",
        padding: "8px",
      }}
    >
      <div
        style={{
          fontWeight: "600",
          fontSize: "14px",
          marginBottom: "4px",
          color: "#0f172a",
        }}
      >
        {data.label}
      </div>

      {/* Optional Handle for connections to group itself */}
      <Handle
        type="target"
        position={Position.Top}
        style={{ background: "#0f172a", visibility: "hidden" }}
      />
      <Handle
        type="source"
        position={Position.Bottom}
        style={{ background: "#0f172a", visibility: "hidden" }}
      />
    </div>
  );
};

export default GroupNode;
