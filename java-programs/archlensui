import dagre from "dagre";
import { v4 as uuidv4 } from "uuid";

export const layoutWithStandalone = (nodes, edges, rankdir = "TB") => {
  const dagreGraph = new dagre.graphlib.Graph();
  dagreGraph.setDefaultEdgeLabel(() => ({}));
  dagreGraph.setGraph({ rankdir, nodesep: 100, ranksep: 200 });

  if (!nodes || nodes.length === 0) return { nodes: [], edges };
  if (!edges) edges = [];

  const connectedIds = new Set(edges.flatMap(e => [e.source, e.target]));
  const connectedNodes = nodes.filter(n => connectedIds.has(n.id));
  const standaloneNodes = nodes.filter(n => !connectedIds.has(n.id));

  connectedNodes.forEach(n =>
    dagreGraph.setNode(n.id, { width: 240, height: 140 }) // Increased size
  );
  edges.forEach(e => dagreGraph.setEdge(e.source, e.target));
  dagre.layout(dagreGraph);

  let maxX = 0, maxY = 0;
  connectedNodes.forEach(n => {
    const pos = dagreGraph.node(n.id);
    if (pos) {
      maxX = Math.max(maxX, pos.x);
      maxY = Math.max(maxY, pos.y);
    }
  });

  const layoutedConnected = connectedNodes.map(node => {
    const pos = dagreGraph.node(node.id) || { x: 0, y: 0 };
    return {
      ...node,
      position: { x: pos.x, y: pos.y },
      sourcePosition: rankdir === "LR" ? "right" : "bottom",
      targetPosition: rankdir === "LR" ? "left" : "top",
    };
  });

  // --- Position standalone nodes with grid spacing ---
  const padding = 300;
  const gridSpacingX = 300;
  const gridSpacingY = 200;
  const columns = 4;

  const startX = rankdir === "LR" ? maxX + padding : 0;
  const startY = rankdir === "LR" ? 0 : maxY + padding;

  const layoutedStandalone = standaloneNodes.map((node, idx) => {
    const row = Math.floor(idx / columns);
    const col = idx % columns;
    const x = startX + col * gridSpacingX;
    const y = startY + row * gridSpacingY;
    return {
      ...node,
      position: { x, y },
      sourcePosition: rankdir === "LR" ? "right" : "bottom",
      targetPosition: rankdir === "LR" ? "left" : "top",
    };
  });

  return {
    nodes: [...layoutedConnected, ...layoutedStandalone],
    edges,
  };
};
