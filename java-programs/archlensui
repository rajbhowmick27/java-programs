import { getBezierPath } from 'reactflow';

export const CustomSmoothStepEdge = ({
  sourceX,
  sourceY,
  targetX,
  targetY,
  data,
  label,
  labelX,
  labelY,
  markerEnd,
  style,
}) => {
  const curvature = data?.curvature ?? 0.2;
  const [edgePath, labelXPos, labelYPos] = getBezierPath({
    sourceX,
    sourceY,
    targetX,
    targetY,
    curvature,
  });

  return (
    <>
      <path
        id="edge-path"
        style={style}
        className="react-flow__edge-path"
        d={edgePath}
        markerEnd={markerEnd}
      />
      {label && (
        <text x={labelXPos} y={labelYPos} className="edge-text" dominantBaseline="middle" textAnchor="middle">
          {label}
        </text>
      )}
    </>
  );
};


const edgeTypes = {
  smoothstep: CustomSmoothStepEdge,
};
